# Stage 1: Base & Dependencies
FROM node:25-slim as base 

COPY ./frontend /frontend
RUN rm -rf /frontend/node_modules
#COPY ./data /frontend/data

WORKDIR /frontend
RUN npm ci

# CMD ["npm", "run", "dev"]

# Stage 2: Development Target
FROM base AS development
EXPOSE 5173
#CMD ["npm", "run", "dev", "--", "--host"]
# use just npm run dev instead of the more verbose one with --host because that is taken care of by vite in the vite.config.js file
CMD ["npm", "run", "dev"]

# Stage 3: Production Target (Compiles the dist folder)
FROM base AS production
CMD ["npm", "run", "build"]

