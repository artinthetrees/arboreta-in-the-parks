#FROM python:3.13.0-alpine3.20
FROM python:3.13 

ENV PYTHONUNBUFFERED=1

# RUN apt-get update && \
# 	apt-get install -y --no-install-recommends --purge postgresql-client gdal-bin && \
# 	apt-get autoclean && \
# 	rm -rf /var/lib/apt/lists/* && \
# 	rm -rf /tmp/*

COPY ./requirements.txt /requirements.txt
COPY ./backend /backend
COPY ./scripts /scripts
#COPY ./data /backend/data

WORKDIR /backend
EXPOSE 8000

# RUN python -m venv env /py && \
#     /py/bin/pip install --upgrade pip && \
#     /py/bin/pip install -r /requirements.txt

# ENV PATH="/py/bin:$PATH"

# CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]

# last line adds a new user called backend that will be used to run the backend app

# original block commented out bc assumes alpine image which uses apk
# have to translate for debian docker image - use apt-get instead of apk and other updates
# RUN python -m venv /py && \
# 	/py/bin/pip install --upgrade pip && \
# 	apk add --update --no-cache postgresql-client && \
# 	apk add --update --no-cache --virtual .tmp-deps \
# 	build-base postgresql-dev musl-dev && \
# 	/py/bin/pip install -r /requirements.txt && \
# 	apk del .tmp-deps && \
# 	adduser --disabled-password --no-create-home backend

# RUN python -m venv /py && \
# 	/py/bin/pip install --upgrade pip && \
# 	apt-get update && \
# 	apt-get install -y --no-install-recommends postgresql-client && \
# 	apt-get install -y --no-install-recommends build-essential libpq-dev && \
# 	/py/bin/pip install -r /requirements.txt && \
# 	apt-get purge -y --auto-remove build-essential libpq-dev && \
# 	rm -rf /var/lib/apt/lists/* && \
# 	useradd --no-create-home backend && \
# 	mkdir -p /vol/web/static && \
# 	mkdir -p /vol/web/media && \
# 	chown -R backend:backend /vol && \
# 	chmod -R 755 /vol

RUN apt-get update && \
	apt-get install -y --no-install-recommends \
	postgresql-client \
	gdal-bin \
	libpq-dev \
	build-essential && \
	python -m venv /py && \
	/py/bin/pip install --upgrade pip --no-cache-dir && \
	/py/bin/pip install -r /requirements.txt --no-cache-dir && \
	apt-get purge -y --auto-remove build-essential && \
	apt-get clean && \
	rm -rf /var/lib/apt/lists/* /tmp/* /var/var/tmp/* && \
	#rm -rf /var/lib/apt/lists/* && \
	adduser --disabled-password --no-create-home backend && \
	mkdir -p /vol/web/static /vol/web/media && \
	chown -R backend:backend /vol && \
	chmod -R 755 /vol && \
	chmod -R +x /scripts

#ENV PATH="/py/bin:$PATH"
ENV PATH="/scripts:/py/bin:$PATH"

# sets user to backend user created above
USER backend

CMD ["run.sh"]